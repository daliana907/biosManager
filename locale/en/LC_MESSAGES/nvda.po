#: biosManager/globalPlugins/biosManager/__init__.py:20
msgid "Gestor de BIOS y UEFI"
msgstr "BIOS and UEFI Manager"

#: biosManager/globalPlugins/biosManager/__init__.py:34
msgid "&Configuración de la BIOS / UEFI..."
msgstr "&BIOS / UEFI Configuration..."

#: biosManager/globalPlugins/biosManager/__init__.py:35
msgid "Abre la ventana accesible para consultar y configurar la BIOS/UEFI"
msgstr "Opens the accessible window to query and configure BIOS/UEFI"

#: biosManager/globalPlugins/biosManager/__init__.py:39
msgid "&Comprobar conflictos con otros complementos..."
msgstr "&Check conflicts with other add-ons..."

#: biosManager/globalPlugins/biosManager/__init__.py:40
msgid ""
"Comprueba si existen conflictos de atajos de teclado o complementos "
"incompatibles con el Gestor de BIOS"
msgstr ""
"Checks for shortcut conflicts or incompatible add-ons with BIOS Manager"

#: biosManager/globalPlugins/biosManager/__init__.py:44
msgid "&Documentación"
msgstr "&Documentation"

#: biosManager/globalPlugins/biosManager/__init__.py:45
msgid "Abre la ayuda y documentación del Gestor de BIOS"
msgstr "Opens BIOS Manager help and documentation"

#: biosManager/globalPlugins/biosManager/__init__.py:52
msgid "&Gestor de BIOS y UEFI"
msgstr "&BIOS and UEFI Manager"

#: biosManager/globalPlugins/biosManager/__init__.py:53
msgid "Opciones y configuración accesible de la BIOS/UEFI"
msgstr "Accessible BIOS/UEFI options and configuration"

#: biosManager/globalPlugins/biosManager/__init__.py:103
msgid "No se encontró el archivo de documentación de BIOS Manager."
msgstr "BIOS Manager documentation file was not found."

#: biosManager/globalPlugins/biosManager/__init__.py:123
msgid "Apertura de la ventana del Gestor de BIOS / UEFI"
msgstr "Opening the BIOS / UEFI Manager window"

#: biosManager/globalPlugins/biosManager/__init__.py:197
msgid ""
"No se han detectado conflictos de atajos de teclado ni complementos "
"incompatibles activos con el Gestor de BIOS."
msgstr ""
"No keyboard shortcut conflicts or active incompatible add-ons detected with "
"BIOS Manager."

#: biosManager/globalPlugins/biosManager/__init__.py:198
#: biosManager/globalPlugins/biosManager/__init__.py:217
msgid "Auditoría de compatibilidad - Gestor de BIOS"
msgstr "Compatibility Audit - BIOS Manager"

#: biosManager/globalPlugins/biosManager/__init__.py:204
msgid "COLISIONES DIRECTAS DE ATAJOS:"
msgstr "DIRECT SHORTCUT COLLISIONS:"

#: biosManager/globalPlugins/biosManager/__init__.py:210
msgid "ADVERTENCIAS DE COMPATIBILIDAD:"
msgstr "COMPATIBILITY WARNINGS:"

#: biosManager/globalPlugins/biosManager/__init__.py:214
msgid ""
"Nota: Los detalles completos también se han registrado en el archivo de log "
"de NVDA."
msgstr "Note: Full details have also been logged to the NVDA log file."

#: biosManager/globalPlugins/biosManager/__init__.py:243
msgid "Abre la ventana de configuración accesible de la BIOS/UEFI."
msgstr "Opens the accessible BIOS/UEFI configuration window."

#: biosManager/globalPlugins/biosManager/__init__.py:253
msgid ""
"Comprueba si existen conflictos de atajos de teclado o complementos "
"incompatibles con el Gestor de BIOS."
msgstr ""
"Checks for keyboard shortcut conflicts or add-ons incompatible with BIOS "
"Manager."

#: biosManager/globalPlugins/biosManager/__init__.py:261
msgid ""
"Reinicia el equipo directamente en la pantalla de configuración del firmware "
"UEFI."
msgstr ""
"Restarts the computer directly into the UEFI firmware configuration screen."

#: biosManager/globalPlugins/biosManager/__init__.py:267
msgid ""
"¿Seguro que deseas reiniciar el equipo ahora mismo para acceder a la BIOS / "
"UEFI?"
msgstr ""
"Are you sure you want to restart the computer right now to enter the BIOS / "
"UEFI?"

#: biosManager/globalPlugins/biosManager/__init__.py:268
msgid "Reiniciar a UEFI - Gestor de BIOS"
msgstr "Restart to UEFI - BIOS Manager"

#: biosManager/globalPlugins/biosManager/dialog.py:15
msgid "Configuración de la BIOS / UEFI"
msgstr "BIOS / UEFI settings"

#: biosManager/globalPlugins/biosManager/dialog.py:22
msgid "&Aceptar"
msgstr "&OK"

#: biosManager/globalPlugins/biosManager/dialog.py:26
msgid "&Cancelar"
msgstr "&Cancel"

#: biosManager/globalPlugins/biosManager/dialog.py:43
msgid "&Buscar ajuste:"
msgstr "&Search setting:"

#: biosManager/globalPlugins/biosManager/dialog.py:51
msgid "L&impiar"
msgstr "C&lear"

#: biosManager/globalPlugins/biosManager/dialog.py:57
msgid "&Lista de Ajustes:"
msgstr "&Settings list:"

#: biosManager/globalPlugins/biosManager/dialog.py:64
msgid "Ajuste"
msgstr "Setting"

#: biosManager/globalPlugins/biosManager/dialog.py:65
msgid "Valor Actual"
msgstr "Current value"

#: biosManager/globalPlugins/biosManager/dialog.py:66
msgid "Pendiente de guardar"
msgstr "Pending save"

#: biosManager/globalPlugins/biosManager/dialog.py:70
msgid "Cargando opciones de BIOS..."
msgstr "Loading BIOS settings..."

#: biosManager/globalPlugins/biosManager/dialog.py:71
msgid "Por favor, espera..."
msgstr "Please wait..."

#: biosManager/globalPlugins/biosManager/dialog.py:111
msgid ""
"No se pudieron leer los ajustes de la BIOS. Puede que hayas cancelado el "
"aviso de permisos de administrador, o que este equipo no sea compatible."
msgstr ""
"Could not read the BIOS settings. You may have cancelled the administrator "
"permission prompt, or this computer may not be supported."

#: biosManager/globalPlugins/biosManager/dialog.py:162
msgid "Selecciona un ajuste en la lista para editarlo."
msgstr "Select a setting from the list to edit it."

#: biosManager/globalPlugins/biosManager/dialog.py:236
msgid ""
"&Orden de arranque. Usa Alt más flecha arriba o abajo para mover el "
"dispositivo elegido:"
msgstr ""
"&Boot order. Use Alt plus up or down arrow to move the selected device:"

#: biosManager/globalPlugins/biosManager/dialog.py:247
msgid "S&ubir"
msgstr "Move &up"

#: biosManager/globalPlugins/biosManager/dialog.py:250
msgid "Ba&jar"
msgstr "Move &down"

#: biosManager/globalPlugins/biosManager/dialog.py:256
msgid "Elige el nuevo valor:"
msgstr "Choose the new value:"

#: biosManager/globalPlugins/biosManager/dialog.py:267
msgid "Fecha (Año, Mes, Día):"
msgstr "Date (Year, Month, Day):"

#: biosManager/globalPlugins/biosManager/dialog.py:282
msgid "Hora (Hora, Minuto, Segundo):"
msgstr "Time (Hour, Minute, Second):"

#: biosManager/globalPlugins/biosManager/dialog.py:297
msgid "Valor numérico:"
msgstr "Numeric value:"

#: biosManager/globalPlugins/biosManager/dialog.py:303
msgid "Texto libre:"
msgstr "Free text:"

#: biosManager/globalPlugins/biosManager/dialog.py:308
msgid "&Añadir a cambios pendientes"
msgstr "&Add to pending changes"

#: biosManager/globalPlugins/biosManager/dialog.py:338
#, python-brace-format
msgid "Solo {dispositivo}."
msgstr "Only {dispositivo}."

#: biosManager/globalPlugins/biosManager/dialog.py:339
#, python-brace-format
msgid "Primero {dispositivo}. {total} dispositivos."
msgstr "{dispositivo} first. {total} devices."

#: biosManager/globalPlugins/biosManager/dialog.py:354
#, python-brace-format
msgid "Quedaría primero {dispositivo}."
msgstr "{dispositivo} would be first."

#: biosManager/globalPlugins/biosManager/dialog.py:358
#, python-brace-format
msgid "{total} cambian de puesto."
msgstr "{total} change position."

#: biosManager/globalPlugins/biosManager/dialog.py:376
#, python-brace-format
msgid "{puesto}, {dispositivo}, antes {anterior}"
msgstr "{puesto}, {dispositivo}, previously {anterior}"

#: biosManager/globalPlugins/biosManager/dialog.py:395
#, python-brace-format
msgid "{dispositivo}, ahora {puesto}, antes {anterior}"
msgstr "{dispositivo}, now {puesto}, previously {anterior}"

#: biosManager/globalPlugins/biosManager/dialog.py:419
msgid "Elige primero un dispositivo de la lista."
msgstr "Select a device from the list first."

#: biosManager/globalPlugins/biosManager/dialog.py:424
#, python-brace-format
msgid "{dispositivo} ya está {extremo} de la lista."
msgstr "{dispositivo} is already {extremo} the list."

#: biosManager/globalPlugins/biosManager/dialog.py:426
msgid "al principio"
msgstr "at the beginning of"

#: biosManager/globalPlugins/biosManager/dialog.py:426
msgid "al final"
msgstr "at the end of"

#: biosManager/globalPlugins/biosManager/dialog.py:433
#, python-brace-format
msgid "{dispositivo}, posición {puesto} de {total}."
msgstr "{dispositivo}, position {puesto} of {total}."

#: biosManager/globalPlugins/biosManager/dialog.py:451
msgid "aparecen dos veces: {}"
msgstr "appear twice: {}"

#: biosManager/globalPlugins/biosManager/dialog.py:453
msgid "faltan: {}"
msgstr "missing: {}"

#: biosManager/globalPlugins/biosManager/dialog.py:455
msgid ""
"No se puede guardar este orden de arranque porque no coincide con los "
"dispositivos del equipo ({})."
msgstr ""
"This boot order cannot be saved because it does not match the devices in "
"this computer ({})."

#: biosManager/globalPlugins/biosManager/dialog.py:457
msgid "la lista quedó distinta"
msgstr "the list ended up different"

#: biosManager/globalPlugins/biosManager/dialog.py:531
#, python-brace-format
msgid "Pendiente en el orden de arranque: {cambios}"
msgstr "Pending in the boot order: {cambios}"

#: biosManager/globalPlugins/biosManager/dialog.py:563
#: biosManager/globalPlugins/biosManager/dialog.py:627
msgid "Se están aplicando los cambios en la BIOS. Espera a que termine."
msgstr ""
"The changes are being applied to the BIOS. Please wait until it finishes."

#: biosManager/globalPlugins/biosManager/dialog.py:573
#, python-brace-format
msgid ""
"Has cambiado {ajuste} a {valor}, pero todavía no lo has añadido a los "
"cambios pendientes. Pulsa el botón Añadir a cambios pendientes, o Cancelar "
"para descartarlo."
msgstr ""
"You have changed {ajuste} to {valor}, but you have not added it to the "
"pending changes yet. Press the Add to pending changes button, or Cancel to "
"discard it."

#: biosManager/globalPlugins/biosManager/dialog.py:584
msgid "No hay cambios que guardar."
msgstr "There are no changes to save."

#: biosManager/globalPlugins/biosManager/dialog.py:599
msgid ""
"Aplicando los cambios en la BIOS. Puede tardar unos segundos; te aviso al "
"terminar."
msgstr ""
"Applying the changes to the BIOS. This may take a few seconds; you will be "
"notified when it finishes."

#: biosManager/globalPlugins/biosManager/dialog.py:608
msgid ""
"Hubo un error inesperado al aplicar los cambios. Revisa el registro de NVDA."
msgstr ""
"An unexpected error occurred while applying the changes. Check the NVDA log."

#: biosManager/globalPlugins/biosManager/dialog.py:618
msgid "Cambios aplicados"
msgstr "Changes applied"

#: biosManager/globalPlugins/biosManager/dialog.py:620
msgid "La BIOS no aceptó todos los cambios"
msgstr "The BIOS did not accept all the changes"

#: biosManager/globalPlugins/biosManager/wmi_backend.py:212
msgid "No hay cambios"
msgstr "No changes"

#: biosManager/globalPlugins/biosManager/wmi_backend.py:271
msgid ""
"No se pudo aplicar ningún cambio. Puede que se cancelara el aviso de "
"permisos de administrador."
msgstr "No change could be applied. The administrator permission prompt may have been cancelled."

#: biosManager/globalPlugins/biosManager/wmi_backend.py:278
msgid ""
"La BIOS respondió algo que no se pudo interpretar. Mira el registro de NVDA "
"para el detalle."
msgstr "The BIOS returned something that could not be interpreted. Check the NVDA log for details."

#: biosManager/globalPlugins/biosManager/wmi_backend.py:293
#, python-brace-format
msgid "primero {dispositivo}, de {total} dispositivos"
msgstr "{dispositivo} first, of {total} devices"

#: biosManager/globalPlugins/biosManager/wmi_backend.py:311
#, python-brace-format
msgid "{ajuste}: confirmado, {valor}."
msgstr "{ajuste}: confirmed, {valor}."

#: biosManager/globalPlugins/biosManager/wmi_backend.py:314
#, python-brace-format
msgid ""
"{ajuste}: la BIOS aceptó el cambio a {pedido}, pero todavía figura como "
"{actual}. Puede que haga falta reiniciar."
msgstr "{ajuste}: the BIOS accepted the change to {pedido}, but it still reads as {actual}. A restart may be required."

#: biosManager/globalPlugins/biosManager/wmi_backend.py:321
msgid "la BIOS no dio ninguna respuesta"
msgstr "the BIOS gave no response"

#: biosManager/globalPlugins/biosManager/wmi_backend.py:322
#, python-brace-format
msgid "{ajuste}: no se aplicó. Motivo: {motivo}. Sigue en {valor}."
msgstr "{ajuste}: not applied. Reason: {motivo}. It remains {valor}."

#: biosManager/globalPlugins/biosManager/wmi_backend.py:329
#, python-brace-format
msgid "{ajuste}: la BIOS no informó nada sobre este ajuste."
msgstr "{ajuste}: the BIOS reported nothing about this setting."

#: biosManager/globalPlugins/biosManager/wmi_backend.py:334
#, python-brace-format
msgid "Al grabar los cambios en la BIOS: {resultado}."
msgstr "When saving the changes to the BIOS: {resultado}."

#: biosManager/globalPlugins/biosManager/wmi_backend.py:334
msgid "sin respuesta"
msgstr "no response"

#: biosManager/globalPlugins/biosManager/wmi_backend.py:348
msgid "Cambios descartados."
msgstr "Changes discarded."

#: biosManager/globalPlugins/biosManager/wmi_backend.py:370
msgid "El sistema se reiniciará en la BIOS / UEFI en 2 segundos."
msgstr "The system will restart into the BIOS / UEFI in 2 seconds."

